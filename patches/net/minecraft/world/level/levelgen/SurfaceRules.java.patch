+    public interface RuleSource extends Function<SurfaceRules.Context, SurfaceRules.SurfaceRule> {
+        Codec<SurfaceRules.RuleSource> DIRECT_CODEC = BuiltInRegistries.MATERIAL_RULE_TYPE
+            .byNameCodec()
+            .dispatch(SurfaceRules.RuleSource::codec, Function.identity());
+        Codec<Holder<SurfaceRules.RuleSource>> HOLDER_CODEC = RegistryFileCodec.create(Registries.MATERIAL_RULE, DIRECT_CODEC);
+        Codec<SurfaceRules.RuleSource> CODEC = HOLDER_CODEC.xmap(holder -> {
+            return switch (holder) {
+                case Holder.Direct<SurfaceRules.RuleSource> direct -> (SurfaceRules.RuleSource)direct.value();
+                case Holder.Reference<SurfaceRules.RuleSource> reference -> new SurfaceRules.HolderRuleSource(reference);
+                default -> throw new MatchException(null, null);
+            };
+        }, value -> {
+            return switch (value) {
+                case SurfaceRules.HolderRuleSource(Holder<SurfaceRules.RuleSource> holder) -> holder;
+                default -> Holder.direct(value);
+            };
+        });
+
+        static MapCodec<? extends SurfaceRules.RuleSource> bootstrap(Registry<MapCodec<? extends SurfaceRules.RuleSource>> registry) {
+            SurfaceRules.register(registry, "bandlands", SurfaceRules.Bandlands.CODEC);
+            SurfaceRules.register(registry, "block", SurfaceRules.BlockRuleSource.CODEC);
+            SurfaceRules.register(registry, "sequence", SurfaceRules.SequenceRuleSource.CODEC);
+            return SurfaceRules.register(registry, "condition", SurfaceRules.TestRuleSource.CODEC);
+        }
+
+        MapCodec<? extends SurfaceRules.RuleSource> codec();
+    }
