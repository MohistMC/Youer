+
+        @Override
+        public Interval range() {
+            return Interval.encapsulating(this.fromValue, this.toValue);
+        }
+
+        @Override
+        public MapCodec<DensityFunctions.YClampedGradient> codec() {
+            return CODEC;
+        }
