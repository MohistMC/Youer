+    private record Ap2(
+        DensityFunctions.TwoArgumentSimpleFunction.Type type, DensityFunction left, DensityFunction right, double rightMinValue, double rightMaxValue
+    ) implements DensityFunctions.TwoArgumentSimpleFunction {
+        public Ap2(DensityFunctions.TwoArgumentSimpleFunction.Type type, DensityFunction left, DensityFunction right) {
+            Interval rightRange = right.range();
+            this(type, left, right, rightRange.min(), rightRange.max());
+            if ((type == DensityFunctions.TwoArgumentSimpleFunction.Type.MIN || type == DensityFunctions.TwoArgumentSimpleFunction.Type.MAX)
+                && !left.range().intersects(rightRange)) {
+                LOGGER.warn("Creating a {} function between two non-overlapping inputs: {} and {}", type, left, right);
+            }
+        }
+
+        @Override
+        public double compute(DensityFunction.FunctionContext context) {
+            double left = this.left.compute(context);
+
+            return switch (this.type) {
+                case ADD -> left + this.right.compute(context);
+                case SUB -> left - this.right.compute(context);
+                case MUL -> left == 0.0 ? 0.0 : left * this.right.compute(context);
+                case DIV -> left == 0.0 ? 0.0 : left / this.right.compute(context);
+                case MIN -> left < this.rightMinValue ? left : Math.min(left, this.right.compute(context));
+                case MAX -> left > this.rightMaxValue ? left : Math.max(left, this.right.compute(context));
+            };
+        }
+
+        @Override
+        public void fillArray(double[] output, DensityFunction.ContextProvider contextProvider) {
+            this.left.fillArray(output, contextProvider);
+            switch (this.type) {
+                case ADD: {
+                    double[] right = new double[output.length];
+                    this.right.fillArray(right, contextProvider);
+
+                    for (int i = 0; i < output.length; i++) {
+                        output[i] += right[i];
+                    }
+                    break;
+                }
+                case SUB: {
+                    double[] right = new double[output.length];
+                    this.right.fillArray(right, contextProvider);
+
+                    for (int i = 0; i < output.length; i++) {
+                        output[i] -= right[i];
+                    }
+                    break;
+                }
+                case MUL:
+                    for (int i = 0; i < output.length; i++) {
+                        double left = output[i];
+                        output[i] = left == 0.0 ? 0.0 : left * this.right.compute(contextProvider.forIndex(i));
+                    }
+                    break;
+                case DIV:
+                    for (int i = 0; i < output.length; i++) {
+                        double left = output[i];
+                        output[i] = left == 0.0 ? 0.0 : left / this.right.compute(contextProvider.forIndex(i));
+                    }
+                    break;
+                case MIN:
+                    for (int i = 0; i < output.length; i++) {
+                        double left = output[i];
+                        output[i] = left < this.rightMinValue ? left : Math.min(left, this.right.compute(contextProvider.forIndex(i)));
+                    }
+                    break;
+                case MAX:
+                    for (int i = 0; i < output.length; i++) {
+                        double left = output[i];
+                        output[i] = left > this.rightMaxValue ? left : Math.max(left, this.right.compute(contextProvider.forIndex(i)));
+                    }
+            }
+        }
+
+        @Override
+        public DensityFunction mapChildren(DensityFunction.Visitor visitor) {
+            return DensityFunctions.TwoArgumentSimpleFunction.create(this.type, visitor.apply(this.left), visitor.apply(this.right));
+        }
+
+        @Override
+        public Interval range() {
+            Interval left = this.left.range();
+            Interval right = this.right.range();
+
+            return switch (this.type) {
+                case ADD -> Interval.add(left, right);
+                case SUB -> Interval.sub(left, right);
+                case MUL -> Interval.mul(left, right);
+                case DIV -> Interval.div(left, right);
+                case MIN -> Interval.min(left, right);
+                case MAX -> Interval.max(left, right);
+            };
+        }
+    }
