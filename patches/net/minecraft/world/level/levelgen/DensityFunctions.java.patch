+    public record Round(DensityFunctions.Round.Type type, DensityFunction input, DensityFunction multiple) implements DensityFunction {
+        private double roundToInteger(double input) {
+            return switch (this.type) {
+                case FLOOR -> Math.floor(input);
+                case ROUND -> Math.round(input);
+                case CEIL -> Math.ceil(input);
+                case TRUNCATE -> input > 0.0 ? Math.floor(input) : Math.ceil(input);
+            };
+        }
+
+        @Override
+        public double compute(DensityFunction.FunctionContext context) {
+            double input = this.input.compute(context);
+            double multiple = this.multiple.compute(context);
+            return multiple == 0.0 ? input : this.roundToInteger(input / multiple) * multiple;
+        }
+
+        @Override
+        public void fillArray(double[] output, DensityFunction.ContextProvider contextProvider) {
+            this.input.fillArray(output, contextProvider);
+            double[] multiples = new double[output.length];
+            this.multiple.fillArray(multiples, contextProvider);
+
+            for (int i = 0; i < output.length; i++) {
+                double multiple = multiples[i];
+                if (multiple != 0.0) {
+                    output[i] = this.roundToInteger(output[i] / multiple) * multiple;
+                }
+            }
+        }
+
+        @Override
+        public DensityFunction mapChildren(DensityFunction.Visitor visitor) {
+            return new DensityFunctions.Round(this.type, visitor.apply(this.input), visitor.apply(this.multiple));
+        }
+
+        @Override
+        public Interval range() {
+            Interval multipleRange = this.multiple.range();
+            return Interval.mul(Interval.mapMonotonic(Interval.div(this.input.range(), multipleRange), this::roundToInteger), multipleRange);
+        }
+
+        @Override
+        public MapCodec<DensityFunctions.Round> codec() {
+            return this.type.codec;
+        }
