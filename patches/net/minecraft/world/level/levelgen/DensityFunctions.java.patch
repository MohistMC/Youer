+    public interface TwoArgumentSimpleFunction extends DensityFunction {
+        Logger LOGGER = LogUtils.getLogger();
+
+        static DensityFunctions.TwoArgumentSimpleFunction create(
+            DensityFunctions.TwoArgumentSimpleFunction.Type type, DensityFunction left, DensityFunction right
+        ) {
+            if (type == DensityFunctions.TwoArgumentSimpleFunction.Type.MUL || type == DensityFunctions.TwoArgumentSimpleFunction.Type.ADD) {
+                if (left instanceof DensityFunctions.Constant constant) {
+                    return new DensityFunctions.MulOrAdd(
+                        type == DensityFunctions.TwoArgumentSimpleFunction.Type.ADD ? DensityFunctions.MulOrAdd.Type.ADD : DensityFunctions.MulOrAdd.Type.MUL,
+                        right,
+                        constant.value
+                    );
+                }
+
+                if (right instanceof DensityFunctions.Constant constant) {
+                    return new DensityFunctions.MulOrAdd(
+                        type == DensityFunctions.TwoArgumentSimpleFunction.Type.ADD ? DensityFunctions.MulOrAdd.Type.ADD : DensityFunctions.MulOrAdd.Type.MUL,
+                        left,
+                        constant.value
+                    );
+                }
+            }
+
+            return new DensityFunctions.Ap2(type, left, right);
+        }
+
+        DensityFunctions.TwoArgumentSimpleFunction.Type type();
+
+        DensityFunction left();
+
+        DensityFunction right();
+
+        @Override
+        default MapCodec<DensityFunctions.TwoArgumentSimpleFunction> codec() {
+            return this.type().codec;
+        }
+
+        enum Type implements StringRepresentable {
+            ADD("add"),
+            SUB("sub"),
+            MUL("mul"),
+            DIV("div"),
+            MIN("min"),
+            MAX("max");
+
+            private final MapCodec<DensityFunctions.TwoArgumentSimpleFunction> codec = RecordCodecBuilder.mapCodec(
+                i -> i.group(
+                        DensityFunction.CODEC.fieldOf("left").forGetter(DensityFunctions.TwoArgumentSimpleFunction::left),
+                        DensityFunction.CODEC.fieldOf("right").forGetter(DensityFunctions.TwoArgumentSimpleFunction::right)
+                    )
+                    .apply(i, (left, right) -> DensityFunctions.TwoArgumentSimpleFunction.create(this, left, right))
+            );
+            private final String name;
+
+            Type(String name) {
+                this.name = name;
+            }
+
+            @Override
+            public String getSerializedName() {
+                return this.name;
+            }
+        }
+    }
