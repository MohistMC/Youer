+    // Youer start - cache chunks confirmed to hold no structure data. Vanilla re-runs a
+    // blocking region-file scan for EVERY (chunk, structure) pair (~10 disk reads per chunk
+    // while pregenerating), stalling the worldgen threads. The scan result for a chunk is
+    // deterministic, so a bounded cache of "empty" chunks is safe; loadedChunks (memory) is
+    // still consulted first, and real data evicts the entry.
+    private static final int MAX_SCANNED_EMPTY_CACHE = 1_000_000;
+    private final it.unimi.dsi.fastutil.longs.LongOpenHashSet scannedEmptyChunks = new it.unimi.dsi.fastutil.longs.LongOpenHashSet();
+
+    private boolean markScannedEmpty(long key) {
+        synchronized (this.scannedEmptyChunks) {
+            if (this.scannedEmptyChunks.size() > MAX_SCANNED_EMPTY_CACHE) {
+                this.scannedEmptyChunks.clear();
+            }
+            return this.scannedEmptyChunks.add(key);
+        }
+    }
+
+    private void unmarkScannedEmpty(long key) {
+        synchronized (this.scannedEmptyChunks) {
+            this.scannedEmptyChunks.remove(key);
+        }
+    }
+    // Youer end
