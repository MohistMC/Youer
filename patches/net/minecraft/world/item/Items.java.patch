     private static Item registerBlock(BlockItemId id, Block block, Block... alternatives) {
-        Item item = registerBlock(id, block);
-
-        for (Block alternative : alternatives) {
-            Item.BY_BLOCK.put(alternative, item);
-        }
+        Item item = registerItem(
+                ResourceKey.create(net.minecraft.core.registries.Registries.ITEM, block.builtInRegistryHolder().key().identifier()),
+                p -> new BlockItem(block, p) {
+                    @Override
+                    public void registerBlocks(java.util.Map<Block, Item> map, Item self) {
+                        super.registerBlocks(map, self);
+                        for (Block block : alternatives) {
+                            map.put(block, self);
+                        }
+                    }
+                },
+                new Item.Properties().useBlockDescriptionPrefix()
+        );
 
         return item;
     }
