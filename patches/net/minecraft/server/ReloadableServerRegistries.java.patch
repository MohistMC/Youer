+    private static <T extends Validatable> CompletableFuture<WritableRegistry<?>> scheduleRegistryLoad(
+        LootDataType<T> type, RegistryOps<JsonElement> ops, ResourceManager manager, Executor taskExecutor, final io.papermc.paper.registry.data.util.Conversions conversions // Paper
