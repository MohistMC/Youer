+    private static final Codec<Map<ResourceLocation, AdvancementProgress>> UNBOUNDED_MAP_CODEC = Codec.unboundedMap(ResourceLocation.CODEC, AdvancementProgress.CODEC);
+    private static final Codec<Map<ResourceLocation, AdvancementProgress>> FAST_MAP_CODEC = new Codec<>() {
+        @Override
+        public <T> DataResult<Pair<Map<ResourceLocation, AdvancementProgress>, T>> decode(DynamicOps<T> ops, T input) {
+            return ops.getMapValues(input).flatMap(stream -> {
+                java.util.List<Pair<T, T>> list = stream.collect(java.util.stream.Collectors.toList());
+                Object2ObjectOpenHashMap<ResourceLocation, AdvancementProgress> map = new Object2ObjectOpenHashMap<>(Math.max(16, list.size() + 1));
+                for (Pair<T, T> entry : list) {
+                    DataResult<ResourceLocation> keyResult = ResourceLocation.CODEC.parse(ops, entry.getFirst());
+                    if (keyResult.error().isPresent()) {
+                        return DataResult.error(() -> "Failed to parse advancement id: " + keyResult.error().get().message());
+                    }
+                    DataResult<AdvancementProgress> valueResult = AdvancementProgress.CODEC.parse(ops, entry.getSecond());
+                    if (valueResult.error().isPresent()) {
+                        return DataResult.error(() -> "Failed to parse advancement progress for '" + keyResult.getOrThrow() + "': " + valueResult.error().get().message());
+                    }
+                    ResourceLocation key = keyResult.getOrThrow();
+                    if (map.putIfAbsent(key, valueResult.getOrThrow()) != null) {
+                        return DataResult.error(() -> "Duplicate advancement id: " + key);
+                    }
+                }
+                return DataResult.success(Pair.of(map, ops.empty()));
+            });
+        }
+
+        @Override
+        public <T> DataResult<T> encode(Map<ResourceLocation, AdvancementProgress> map, DynamicOps<T> ops, T prefix) {
